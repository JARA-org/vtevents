# Copy to .env.production in the repository root and chmod 600.
# Compose 2.30+ reads these as raw values: no quotes, interpolation or inline comments.
# NODE_ENV, PORT and APP_ORIGIN are set by Compose; export GOBBLER_DOMAIN separately.
MONGODB_URI=mongodb+srv://APP_USER:SAFE_PLACEHOLDER@YOUR_CLUSTER.mongodb.net/
MONGODB_DB=my_little_gobbler
BETTER_AUTH_SECRET=GENERATE_32_RANDOM_BYTES_OR_MORE
TOKEN_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
ANALYTICS_SALT=GENERATE_32_RANDOM_BYTES_OR_MORE
JOB_SECRET=GENERATE_32_RANDOM_BYTES_OR_MORE
# Optional integrations: leave empty until configured and approved.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_LIMIT=100
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MONTHLY_CHARACTER_LIMIT=8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CANVAS_BASE_URL=https://canvas.vt.edu
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_WRITES_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_COLLECTION_ENABLED=false
DISCORD_AI_ENABLED=false
DISCORD_AI_DAILY_LIMIT=20
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# Backend only. Never prefix secrets with EXPO_PUBLIC_.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://APP_USER:SAFE_PLACEHOLDER@YOUR_CLUSTER.mongodb.net/
MONGODB_DB=my_little_gobbler
BETTER_AUTH_SECRET=GENERATE_32_RANDOM_BYTES_OR_MORE
TOKEN_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
ANALYTICS_SALT=GENERATE_32_RANDOM_BYTES_OR_MORE
JOB_SECRET=GENERATE_32_RANDOM_BYTES_OR_MORE
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_LIMIT=100
# Optional backend-only narration. Use a provider key with a hard credit quota.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# App-wide ceiling, additionally clamped to 8000 characters per UTC month.
ELEVENLABS_MONTHLY_CHARACTER_LIMIT=8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CANVAS_BASE_URL=https://canvas.vt.edu
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_WRITES_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Comma-separated IDs; only explicit administrator-approved announcement channels.
DATABRICKS_HOST=https://YOUR_WORKSPACE.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

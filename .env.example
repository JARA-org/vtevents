# Backend only. Never prefix secrets with EXPO_PUBLIC_.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
# Leave blank for npm run local. Set a real MongoDB URI for hosted deployments.
MONGODB_URI=
MONGODB_DB=my_little_gobbler
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
ANALYTICS_SALT=
JOB_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_LIMIT=100
# Optional backend-only narration. Use a provider key with a hard credit quota.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# App-wide ceiling, additionally clamped to 8000 characters per UTC month.
ELEVENLABS_MONTHLY_CHARACTER_LIMIT=8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CANVAS_BASE_URL=https://canvas.vt.edu
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_WRITES_ENABLED=false
RESEND_API_KEY=
AUTH_EMAIL_FROM=
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=
# Optional development server for command registration
DISCORD_TEST_GUILD_ID=
DISCORD_BOT_TOKEN=
# Read-only Gateway collection on posts/edits. AI is independently opt-in.
DISCORD_COLLECTION_ENABLED=false
DISCORD_AI_ENABLED=false

# Additional atomic AI caps; zero disables extraction for that scope.
DISCORD_AI_GUILD_DAILY_LIMIT=20
DISCORD_AI_GUILD_HOURLY_LIMIT=5

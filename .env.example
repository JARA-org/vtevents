# Backend only. Never prefix secrets with EXPO_PUBLIC_.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
# Leave blank for npm run local. Set a real MongoDB URI for hosted deployments.
MONGODB_URI=
MONGODB_DB=my_little_gobbler
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
ANALYTICS_SALT=
JOB_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true only after verifying this API key's project is on Free Tier with billing disabled.
# Ask Gobbler fails closed to live discovery until confirmed. Never enable paid fallback.
GEMINI_FREE_TIER_CONFIRMED=false
# Assistant ceilings; invalid values disable AI, lower limits are supported.
# All model features sharing the provider project still share Google's quotas.
GEMINI_DAILY_LIMIT=100
GEMINI_USER_DAILY_LIMIT=20
GEMINI_ASSISTANT_RPM=4
RESEND_API_KEY=
AUTH_EMAIL_FROM=
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=
# Optional development server for command registration
DISCORD_TEST_GUILD_ID=
DISCORD_BOT_TOKEN=
# Read-only Gateway collection on posts/edits. AI is independently opt-in.
DISCORD_COLLECTION_ENABLED=false
DISCORD_AI_ENABLED=false

# Additional atomic AI caps; zero disables extraction for that scope.
DISCORD_AI_GUILD_DAILY_LIMIT=20
DISCORD_AI_GUILD_HOURLY_LIMIT=5
